PORT=3000

# Meta 개발자 앱에서 발급받은 값 (README 참고)
THREADS_APP_ID=
THREADS_APP_SECRET=
# 배포한 실제 주소 + /auth/callback (예: https://yourapp.up.railway.app/auth/callback)
THREADS_REDIRECT_URI=

# 쿠팡파트너스 개발자센터(partners.coupang.com)에서 발급받은 값
# 여기 안 넣고 배포 후 "연결 설정" 탭에서 직접 입력해도 됨
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_SUB_ID=
